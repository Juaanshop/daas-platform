# Base de datos SQLite
DATABASE_URL="file:./dev.db"

# URL de la aplicación
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Maps API Configuration
# Requiere habilitar en Google Cloud Console:
# 1. Places API (New) / Places API
# 2. Maps JavaScript API
# 3. Distance Matrix API (o Routes API)

# Clave pública para el cliente web (Places Autocomplete y Mapas)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIzaSy..."

# Clave privada para llamadas backend (Distance Matrix / Ruteo vial)
# (Puede ser la misma en entornos de desarrollo sin restricciones de IP)
GOOGLE_MAPS_SERVER_KEY="AIzaSy..."
