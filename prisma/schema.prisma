datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  role      String    @default("MERCHANT") // ADMIN, MERCHANT, RIDER
  createdAt DateTime  @default(now())
  merchant  Merchant?
  rider     Rider?
}

model Merchant {
  id           String            @id @default(cuid())
  userId       String            @unique
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName String
  address      String
  latitude     Float
  longitude    Float
  phone        String
  balance      Float             @default(0.0)
  isActive     Boolean           @default(true)
  orders       Order[]
  settlements  DailySettlement[]
  createdAt    DateTime          @default(now())
}

model Rider {
  id           String            @id @default(cuid())
  userId       String            @unique
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone        String
  vehiclePlate String
  status       String            @default("IDLE") // IDLE, BUSY, OFFLINE
  isActive     Boolean           @default(true)
  currentLat   Float?
  currentLng   Float?
  orders       Order[]
  settlements  DailySettlement[]
  createdAt    DateTime          @default(now())
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique // Ej. #ORD-1001
  merchantId     String
  merchant       Merchant    @relation(fields: [merchantId], references: [id])
  riderId        String?
  rider          Rider?      @relation(fields: [riderId], references: [id])
  
  pickupAddress  String
  pickupLat      Float
  pickupLng      Float
  
  dropoffAddress String
  dropoffLat     Float
  dropoffLng     Float
  dropoffMapUrl  String?
  
  recipientName  String
  recipientPhone String
  packageNotes   String?
  
  baseFee        Float
  distanceKm     Float
  totalCost      Float
  
  status         String      @default("PENDING") // PENDING, ASSIGNED, PICKING_UP, IN_TRANSIT, DELIVERED, CANCELLED
  
  createdAt      DateTime    @default(now())
  pickedUpAt     DateTime?
  deliveredAt    DateTime?
}

model DailySettlement {
  id              String    @id @default(cuid())
  merchantId      String?
  merchant        Merchant? @relation(fields: [merchantId], references: [id])
  riderId         String?
  rider           Rider?    @relation(fields: [riderId], references: [id])
  date            DateTime
  totalDeliveries Int       @default(0)
  totalAmount     Float     @default(0.0)
  status          String    @default("PENDING") // PENDING, SETTLED
  createdAt       DateTime  @default(now())
}
